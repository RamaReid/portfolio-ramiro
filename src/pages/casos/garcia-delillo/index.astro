---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { caseStudy, capabilities, garciaDelilloIdentityUrl, garciaDelilloLayers, garciaDelilloWebUrl, stages } from '../../../data/portfolio';
import { sitePath, siteUrl } from '../../../data/site';
import '../../../styles/global.css';

const caseCapabilities = capabilities.filter((capability) => capability.caseIds.includes(caseStudy.id));
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: caseStudy.title,
  description: caseStudy.summary,
  url: `${siteUrl}/casos/garcia-delillo/`,
};
---
<BaseLayout title={`${caseStudy.title} - Portfolio`} description={caseStudy.summary} canonical={caseStudy.href}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
  <section class="case-hero page-width">
    <p class="breadcrumb"><a href={sitePath('/')}>Inicio</a> / Caso</p>
    <p class="eyebrow">Caso piloto</p>
    <h1>{caseStudy.title}</h1>
    <p class="lede">{caseStudy.summary}</p>
    <p><a class="button-link" href={garciaDelilloWebUrl} target="_blank" rel="noreferrer">Entrar a la web de Garcia Delillo</a></p>
  </section>

  <section class="section page-width" aria-labelledby="capas-titulo">
    <div class="section-heading"><div><p class="eyebrow">Una misma carpeta de trabajo</p><h2 id="capas-titulo">La identidad conduce a la experiencia y a las obras</h2></div><p>El portfolio presenta la relacion entre las partes; el desarrollo completo vive en la web de Garcia Delillo.</p></div>
    <div class="card-grid">
      {garciaDelilloLayers.map((layer) => <article class="card" id={layer.id}><div><h3>{layer.title}</h3><p>{layer.description}</p></div><a class="text-link" href={layer.id === 'identidad-empresarial' ? garciaDelilloIdentityUrl : layer.id === 'web-y-animacion' ? `${garciaDelilloIdentityUrl}#animacion` : garciaDelilloWebUrl} target={layer.id === 'obras-construidas' ? '_blank' : undefined} rel={layer.id === 'obras-construidas' ? 'noreferrer' : undefined}>{layer.id === 'obras-construidas' ? 'Explorar la web' : 'Ver desarrollo'}</a></article>)}
    </div>
  </section>

  <section class="section page-width" aria-labelledby="recorrido-titulo">
    <div class="prose">
      <p class="eyebrow">El output cambia. El metodo permanece.</p>
      <h2 id="recorrido-titulo">Un recorrido profesional relacionado</h2>
      <p>El portfolio conserva el recorrido profesional que conecta representacion y modelado, diseno y desarrollo de proyectos, y direccion de obras. La web de Garcia Delillo contiene la experiencia institucional y el catalogo completo.</p>
    </div>
    <div class="stage-grid">
      {stages.map((stage) => <article class="stage-card" id={stage.slug}><strong>{stage.periodLabel}</strong><h3>{stage.title}</h3><p>{stage.description}</p></article>)}
    </div>
  </section>

  <section class="section page-width" aria-labelledby="capacidades-titulo">
    <div class="section-heading"><div><p class="eyebrow">Capacidades</p><h2 id="capacidades-titulo">Lo que conecta el caso con mi trabajo</h2></div><p>Estas capacidades pertenecen a la lectura del portfolio y no reemplazan el contenido de la web de la empresa.</p></div>
    <div class="card-grid">
      {caseCapabilities.map((capability) => <a class="card" href={sitePath(`/capacidades/${capability.slug}/`)}><div><h3>{capability.title}</h3><p>{capability.description}</p></div><span class="text-link">Ver capacidad</span></a>)}
    </div>
  </section>

  <section class="section page-width" aria-labelledby="obras-titulo">
    <div class="section-heading"><div><p class="eyebrow">Obras construidas</p><h2 id="obras-titulo">El catalogo completo esta en Garcia Delillo</h2></div><p>Las casas y sus recursos visuales pertenecen a la web de la empresa. El portfolio conserva esta entrada para no separar las obras de la identidad que las organiza.</p></div>
    <p><a class="button-link" href={garciaDelilloWebUrl} target="_blank" rel="noreferrer">Explorar Arquitectura, Diseno y Construccion</a></p>
  </section>
</BaseLayout>
