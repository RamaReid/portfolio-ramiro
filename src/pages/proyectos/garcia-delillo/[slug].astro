---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getProject, projects, garciaDelilloWebUrl } from '../../../data/portfolio';
import { sitePath } from '../../../data/site';
import '../../../styles/global.css';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug } }));
}

const slug = Astro.params.slug ?? '';
const project = getProject(slug);
if (!project) throw new Error(`Proyecto no encontrado: ${slug}`);
---
<BaseLayout title={`${project.title} - Garcia Delillo`} description={project.lead} canonical={`/proyectos/garcia-delillo/${project.slug}/`}>
  <section class="project-hero page-width">
    <p class="breadcrumb"><a href={sitePath('/')}>Inicio</a> / <a href={sitePath('/casos/garcia-delillo/')}>Garcia Delillo</a> / Obra</p>
    <p class="eyebrow">Contenido de la web de Garcia Delillo</p>
    <h1>{project.title}</h1>
    <p class="project-lead">{project.lead}</p>
    <p>Esta obra forma parte del sitio de Garcia Delillo Arquitectura, Diseno y Construccion. El portfolio funciona como entrada y no duplica su relato ni su galeria.</p>
    <p class="hero-actions"><a class="button-link" href={garciaDelilloWebUrl} target="_blank" rel="noreferrer">Abrir la web de Garcia Delillo</a> <a class="text-link" href={sitePath('/casos/garcia-delillo/')}>Volver al caso</a></p>
  </section>
</BaseLayout>
