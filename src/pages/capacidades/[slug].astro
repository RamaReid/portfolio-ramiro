---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { capabilities, caseStudies, stages } from '../../data/portfolio';
import { sitePath } from '../../data/site';
import '../../styles/global.css';

export function getStaticPaths() {
  return capabilities.map((capability) => ({ params: { slug: capability.slug } }));
}

const capability = capabilities.find((item) => item.slug === Astro.params.slug);
if (!capability) throw new Error(`Capacidad no encontrada: ${Astro.params.slug}`);
const relatedStages = stages.filter((stage) => capability.stageIds.includes(stage.id));
const relatedCases = caseStudies.filter((item) => capability.caseIds.includes(item.id));
---
<BaseLayout title={`${capability.title} · Portfolio`} description={capability.description} canonical={`/capacidades/${capability.slug}/`}>
  <section class="project-hero page-width">
    <p class="breadcrumb"><a href={sitePath('/')}>Inicio</a> / Capacidad</p>
    <p class="eyebrow">Capacidad</p>
    <h1>{capability.title}</h1>
    <p class="project-lead">{capability.description}</p>
  </section>
  <section class="section page-width" aria-labelledby="relacion-titulo">
    <div class="prose"><h2 id="relacion-titulo">Relación con el recorrido</h2><p>Esta capacidad forma parte de la organización editorial del portfolio y se conecta con el mapa, la navegación textual y los casos relacionados.</p></div>
    {relatedStages.length > 0 && <div class="stage-grid">{relatedStages.map((stage) => <article class="stage-card"><strong>{stage.periodLabel}</strong><h3>{stage.title}</h3><p>{stage.description}</p><a class="text-link" href={sitePath(`/trayectoria/#${stage.slug}`)}>Abrir etapa</a></article>)}</div>}
    {relatedCases.length > 0 && <div class="card-grid capability-cases">{relatedCases.map((item) => <a class="card" href={item.href}><div><p class="eyebrow">Caso relacionado</p><h3>{item.title}</h3><p>{item.summary}</p></div><span class="text-link">Abrir caso</span></a>)}</div>}
  </section>
</BaseLayout>
