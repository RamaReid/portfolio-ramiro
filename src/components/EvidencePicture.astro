---
import type { EvidenceAsset } from '../data/evidence';
import { siteBase } from '../data/site';

interface Props {
  asset: EvidenceAsset;
}

const { asset } = Astro.props;
---
<picture>
  <source srcset={`${siteBase}${asset.src}`} type="image/webp" />
  <img src={`${siteBase}${asset.fallbackSrc}`} alt={asset.alt} width={asset.width} height={asset.height} loading="lazy" decoding="async" />
</picture>
