---
import { siteBase, sitePath, siteUrl } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  bodyClass?: string;
}

const {
  title = 'Portfolio de Ramiro García Reid',
  description = 'Portfolio profesional organizado alrededor del eje: El output cambia. El método permanece.',
  canonical,
  bodyClass = '',
} = Astro.props;
const canonicalUrl = canonical
  ? canonical.startsWith('http')
    ? canonical
    : `${siteUrl}${canonical.startsWith(siteBase) ? canonical.slice(siteBase.length) : canonical}`
  : siteUrl;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="site-header">
      <div class="page-width header-inner">
        <a class="brand" href={sitePath('/')} aria-label="Ir al inicio: Ramiro García Reid">
          <img class="brand-avatar" src={sitePath('/perfil/foto-perfil-2.png')} alt="" width="48" height="48" loading="eager" decoding="async" />
          <span>Ramiro García Reid</span>
        </a>
        <nav aria-label="Navegación principal">
          <a href={sitePath('/casos/')}>Casos</a>
          <a href={sitePath('/casos/garcia-delillo/')}>Caso piloto</a>
          <a href={sitePath('/trayectoria/')}>Trayectoria</a>
          <a href={sitePath('/markdown/')}>Markdown</a>
          <a href={sitePath('/contacto/')}>Contacto</a>
        </nav>
      </div>
    </header>
    <main id="contenido">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="page-width">
        <p>El output cambia. El método permanece.</p>
        <p><a class="text-link" href={sitePath('/contacto/')}>Contacto y perfil público</a></p>
      </div>
    </footer>
  </body>
</html>
